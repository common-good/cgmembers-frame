 *     MAKE appsignin TheRightPasswordUnlocks
 *     MAKE appsignin AWrongPasswordDoesNotUnlock
 *     MAKE cgpaysignupverify TheNodeAppCompletesSignupWithAWeakPassword
 */
function cgpayPostsWith($op, $args) {
  global $testOnly; if ($testOnly) return FALSE;
  return appPost($op, $args, TRUE);
}

/**
 * Post the fields as JSON to the server-to-server endpoint cgpay/<op>, with the shared secret or without.
 */
function appPost($op, $args, $withSecret) {
  global $testBody;
  u\EXPECT(CGPAY_SSO_SECRET, 'Set cgpaySsoSecret in config.json to run the cgpay endpoint tests.');
  $params = nni($args, 0) ?: [];
  t\fixTestVars($params);
  t\fixData($params);
  $testBody = json_encode($params);
  t\SERVER('REQUEST_METHOD', 'POST');
  t\SERVER('HTTP_X_CG_INTERNAL_TOKEN', $withSecret ? CGPAY_SSO_SECRET : '');
  return t\memberVisitsPage('?', "cgpay/$op");
}

/**
 * a stranger posts (ARG) with: (ARG)
 *
 * in: MAKE appsignin ACallerWithoutTheSharedSecretIsRefused
 */
function aStrangerPostsWith($op, $args) {
  global $testOnly; if ($testOnly) return FALSE;
  return appPost($op, $args, FALSE);
}

/**
 * we email (ARG) to member (ARG) with subs: (ARG)
 *
 * in: TEST cgpay TheNodeAppAsksToEmailAResetCode
 *     TEST cgpay TheNodeAppAsksToTextAResetCodeButTextingIsNotAvailable
 *     TEST cgpay TheNodeAppCompletesAVerifiedReset
 *     TEST appsignin AMemberWithMFAIsAskedForThePasscode
 */
function weEmailToMemberWithSubs($key, $email, $subs) {return t\findEmail($key, $email, $subs);}

/**
 * reply (ARG) is kept as var (ARG)
 *
 * in: MAKE appsignin TheRightPasscodeSignsTheAppIn
 *     MAKE appsignin APasscodeHandleSignsTheAppInOnlyOnce
 *     MAKE appsignin APasscodeHandleExpiresAfterTenMinutes
 *     MAKE appsignin AWrongPasscodeGetsNoToken
 *     MAKE appsignin ATrustedDeviceSignsInWithoutAPasscode
 *     MAKE appsignin AnotherDeviceIsNotTrusted
 *     MAKE appsignin TheAppAsksForItsDeviceCredentials
 *     MAKE appsignin ASignedoutTokenNoLongerWorks
 *     MAKE appsignin ATokenNotUsedForDaysStopsWorking
 *     MAKE appsignin ATokenInUseKeepsWorkingPastDays
 *     MAKE appsignin SigningOutEverywhereEndsEveryDeviceAndItsTrust
 *     MAKE appsignin ANewPasswordSignsTheAppOutOnEveryDeviceAndEndsItsTrust
 *     MAKE appsignin AOnetimeCodeOpensALivePageOnce
 *     MAKE appsignin AOnetimeCodeWorksOnlyOnce
 *     MAKE appsignin AOnetimeCodeExpiresAfterAMinute
 *     MAKE appsignin APageOnAnotherSiteCannotBeAskedFor
 *     MAKE appsignin AProtocolrelativePageCannotBeAskedForEither
 *     MAKE appsignin TheAppOpensTheLiveSiteActingForAnotherAccount
 *     MAKE appsignin TheAppCannotOpenTheLiveSiteForAnAccountTheMemberDoesNotManage
 *     MAKE appsignin AnAdminTypesAnAccount
 *     MAKE appsignin AMemberWhoIsNotAnAdminCannotTypeAnAccountOutsideTheirList
 *     MAKE appsignin TheRightPasswordUnlocks
 *     MAKE appsignin AWrongPasswordDoesNotUnlock
 */
function replyIsKeptAsVar($field, $var) {
  global $testOnly, $testVars; if ($testOnly) return FALSE;
  $got = json_decode(t\getExitMsg(), TRUE);
  return isset($got[$field]) and ($testVars[$var] = $got[$field]) !== NULL;
}

/**
 * reply list (ARG) includes: (ARG)
 *
 * in: TEST appsignin SigningInListsTheAccountsTheMemberMayActFor
 *     TEST appsignin AnAdminTypesAnAccount
 */
function replyListIncludes($field, $want) {
  global $testOnly; if (!$testOnly) return FALSE;
  $got = nni(json_decode(t\getExitMsg(), TRUE) ?: [], $field) ?: [];
  if (!isset($got[0])) $got = [$got];
  $s = function ($v) {return is_bool($v) ? ($v ? 'true' : 'false') : (is_null($v) ? 'NULL' : (is_array($v) ? 'array' : (string) $v));};
  foreach ($want as $one) {
    t\fixData($one);
    $found = FALSE;
    foreach ($got as $g) {
      $found = TRUE;
      foreach ($one as $k => $v) if (!array_key_exists($k, $g) or ($v === '?' ? $g[$k] === NULL : $s($v) !== $s($g[$k]))) $found = FALSE;
      if ($found) break;
    }
    if (!$found) return t\output('No match in ' . $field . ' for ' . pr($one) . ' in ' . pr($got)) and FALSE;
  }
  return TRUE;
}

/**
 * we reply (ARG) with field error (ARG): (ARG)
 *
 * in: TEST cgpay TheNodeAppCompletesAVerifiedResetWithAWeakPassword
 *     TEST cgpaysignupverify TheNodeAppCompletesSignupWithAWeakPassword
 */
function weReplyWithFieldError($wantStatus, $field, $index) {return weReplyWith($wantStatus, json_encode(['errors' => [$field => tr($index)]]));}

/**
 * member (ARG) one-time password is (ARG)
 *
 * in: BOTH cgpaysignupverify TheNodeAppCompletesSignupWithAWeakPassword
 */
function memberOnetimePasswordIs($id, $pass) {
  global $testOnly;
  if (!$a = r\acct($uid = t\uid($id))) return FALSE;
  if (!$testOnly) {
    $expires = REQUEST_TIME + R_SIGNIN_HOURS * HOUR_SECS;
    $oneTimePass = compact('pass', 'expires');
    $a->update(compact('oneTimePass'));
  }
  return ($a->oneTimePass['pass'] == $pass and $a->oneTimePass['expires'] > REQUEST_TIME);
}

/**
 * the time now is (ARG)
 *
 * in: MAKE appsignin APasscodeHandleExpiresAfterTenMinutes
 *     MAKE appsignin ATokenNotUsedForDaysStopsWorking
 *     MAKE appsignin ATokenInUseKeepsWorkingPastDays
 *     MAKE appsignin AOnetimeCodeExpiresAfterAMinute
 */
function theTimeNowIs($tm) {return t\timeIs($tm);}
