 * we reply (ARG) with JSON values: (ARG)
 *
 * in: TEST appsignin AMemberSignsInToTheApp
 *     TEST appsignin AMemberSignsInByEmailAddress
 *     TEST appsignin AWrongPasswordGetsNoToken
 *     TEST appsignin AnUnknownAccountGetsNoToken
 *     TEST appsignin AMemberWithMFAIsAskedForThePasscode
 *     TEST appsignin TheRightPasscodeSignsTheAppIn
 *     TEST appsignin APasscodeHandleSignsTheAppInOnlyOnce
 *     TEST appsignin APasscodeHandleExpiresAfterTenMinutes
 *     TEST appsignin AWrongPasscodeGetsNoToken
 *     TEST appsignin ATrustedDeviceSignsInWithoutAPasscode
 *     TEST appsignin AnotherDeviceIsNotTrusted
 *     TEST appsignin TheAppAsksForItsDeviceCredentials
 *     TEST appsignin AMadeupTokenIsRefused
 *     TEST appsignin ASignedoutTokenNoLongerWorks
 *     TEST appsignin ATokenNotUsedForDaysStopsWorking
 *     TEST appsignin ATokenInUseKeepsWorkingPastDays
 *     TEST appsignin SigningOutEverywhereEndsEveryDeviceAndItsTrust
 *     TEST appsignin ANewPasswordSignsTheAppOutOnEveryDeviceAndEndsItsTrust
 *     TEST appsignin AOnetimeCodeOpensALivePageOnce
 *     TEST appsignin AOnetimeCodeWorksOnlyOnce
 *     TEST appsignin AOnetimeCodeExpiresAfterAMinute
 *     TEST appsignin APageOnAnotherSiteCannotBeAskedFor
 *     TEST appsignin AProtocolrelativePageCannotBeAskedForEither
 *     TEST appsignin TheAppOpensTheLiveSiteActingForAnotherAccount
 *     TEST appsignin TheAppCannotOpenTheLiveSiteForAnAccountTheMemberDoesNotManage
 *     TEST appsignin AMemberWhoIsNotAnAdminCannotTypeAnAccountOutsideTheirList
 *     TEST appsignin TheRightPasswordUnlocks
 *     TEST appsignin AWrongPasswordDoesNotUnlock
 *     TEST info TheAppAsksForRecentTransactions
 *     TEST test TheAppAsksUsForTransactionData
 *     TEST test TheAppAsksUsForTheStoreAppsSigninTokens
 */
function weReplyWithJSONValues($wantStatus, $want) {
  global $testOnly, $testVars; if (!$testOnly) return FALSE; // maybe combine this with weExitShowing?
  if (!$gotJson = t\getExitMsg($gotStatus)) return FALSE;
/**/  db\del('test', "type='echo'"); // reset for subsequent steps
  if (!t\eq('status', u\consta('x', $wantStatus), $gotStatus)) return FALSE;
  $got = json_decode($gotJson);
  if (rayhas($want, 0)) {
    foreach ($want as $i => $one) t\fixData($want[$i]);
  } else t\fixData($want);
  return t\objEq('reply values', $want, (array) $got);
}

