/**
 * the browser at (ARG) sends session cookies: (ARG)
 *
 * in: MAKE sessioncookies AStaleCookieComesBeforeTheLiveOne
 *     MAKE sessioncookies TwoStaleCookiesAndNoLiveOne
 *     MAKE sessioncookies ACookieWithAnotherNameIsNotPartOfIt
 *     MAKE sessioncookies ASingleCookieIsLeftAlone
 *     MAKE sessioncookies TheApexSiteHasNoParentDomainToExpire
 */
function theBrowserAtSendsSessionCookies($host, $values) {
  global $testOnly, $cookie_domain; if ($testOnly) return FALSE;
  $was = $cookie_domain; $cookie_domain = ".$host";
  $cooks = array_map(function($v) {return strhas($v, '=') ? $v : session_name() . "=$v";}, ray($values));
  t\SERVER('HTTP_COOKIE', join('; ', $cooks));
  $_COOKIE[session_name()] = preg_replace('/^[^=]*=/', '', $cooks[0]); // PHP keeps the first value
  $doms = array_map(function($d) {return $d ?: 'host';}, r\healSessionCookies()); $cookie_domain = $was;
  return db\insert('test', ray('type value', 'cookies', json_encode(['cookie' => $_COOKIE[session_name()], 'expired' => join(' ', $doms)])));
}

/**
 * the session cookie is (ARG)
 *
 * in: TEST sessioncookies AStaleCookieComesBeforeTheLiveOne
 *     TEST sessioncookies TwoStaleCookiesAndNoLiveOne
 *     TEST sessioncookies ACookieWithAnotherNameIsNotPartOfIt
 *     TEST sessioncookies ASingleCookieIsLeftAlone
 *     TEST sessioncookies TheApexSiteHasNoParentDomainToExpire
 */
function theSessionCookieIs($want) {
  global $testOnly; if (!$testOnly) return FALSE;
  return t\eq('session cookie', $want, nni(json_decode(db\get('value', 'test', "type='cookies' ORDER BY id DESC"), TRUE), 'cookie'));
}

